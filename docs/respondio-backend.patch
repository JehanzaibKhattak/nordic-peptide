+<?php
+declare(strict_types=1);
+namespace Avion\Messaging;
+
+/** An expiring bearer link grants access only to one order's packing media. */
+final class PackingProof
+{
+    public static function url(int $orderId, int $expires): string
+    {
+        $base = (string)\config('app.base_url');
+        $key = (string)\config('integrations.credentials.respondio.proof_secret', '');
+        if ($orderId < 1 || strlen($key) < 32 || !str_starts_with($base, 'https://')) {
+            throw new \RuntimeException('Private packing links are not configured');
+        }
+        $signature = hash_hmac('sha256', $orderId . ':' . $expires, $key);
+        return rtrim($base, '/') . '/packing-proof/' . $orderId . '?expires=' . $expires . '&signature=' . $signature;
+    }
+
+    public static function verify(int $orderId, int $expires, string $signature): bool
+    {
+        if ($expires < time() || $expires > time() + 15 * 86400 || !preg_match('/^[a-f0-9]{64}$/D', $signature)) {
+            return false;
+        }
+        try {
+            parse_str((string)parse_url(self::url($orderId, $expires), PHP_URL_QUERY), $query);
+            return hash_equals($query['signature'], $signature);
+        } catch (\RuntimeException) {
+            return false;
+        }
+    }
+}
