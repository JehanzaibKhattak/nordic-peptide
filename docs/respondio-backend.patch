+<?php
+declare(strict_types=1);
+namespace Avion\Controllers;
+
+use Avion\Database;
+use Avion\Messaging\PackingProof;
+use Avion\Uploads;
+
+final class PackingProofController
+{
+    public function show(string $id): string
+    {
+        header('Cache-Control: private, no-store');
+        header('Referrer-Policy: no-referrer');
+        header('X-Robots-Tag: noindex, nofollow, noarchive');
+        $expiry = $_GET['expires'] ?? '';
+        $signature = $_GET['signature'] ?? '';
+        if (!ctype_digit($id) || !is_string($expiry) || !ctype_digit($expiry) || !is_string($signature)
+            || !PackingProof::verify((int)$id, (int)$expiry, $signature)) {
+            http_response_code(404);
+            return 'This packing link is invalid or has expired.';
+        }
+        $s = Database::pdo()->prepare('SELECT id, path, mime FROM order_media WHERE order_id = ? AND kind = ? ORDER BY id');
+        $s->execute([(int)$id, 'proof']);
+        $files = $s->fetchAll();
+        if (isset($_GET['file'])) {
+            if (!is_string($_GET['file']) || !ctype_digit($_GET['file'])) {
+                http_response_code(404);
+                return 'Packing media is unavailable.';
+            }
+            foreach ($files as $file) {
+                if ((string)$file['id'] !== (string)$_GET['file']) { continue; }
+                $path = Uploads::absolute((string)$file['path']);
+                $root = realpath(Uploads::root() . '/proof/' . (int)$id);
+                if (!$path || !$root || !str_starts_with($path, $root . '/') || !is_file($path) || !is_readable($path) || !isset(Uploads::ALLOWED[$file['mime']])) { break; }
+                header('Content-Type: ' . $file['mime']);
+                header('Content-Length: ' . filesize($path));
+                header('Content-Disposition: attachment; filename="packing-' . (int)$file['id'] . '.' . Uploads::ALLOWED[$file['mime']] . '"');
+                header('X-Content-Type-Options: nosniff');
+                readfile($path);
+                return '';
+            }
+            http_response_code(404);
+            return 'Packing media is unavailable.';
+        }
+        $url = PackingProof::url((int)$id, (int)$_GET['expires']);
+        $html = '<!doctype html><html lang="en"><meta name="viewport" content="width=device-width,initial-scale=1"><meta charset="utf-8"><title>Peptbay packing photos and videos</title><body><main><h1>Your packing photos and videos</h1><p>This private link expires after 14 days. Please keep it private.</p><ul>';
+        foreach ($files as $n => $file) {
+            $html .= '<li><a href="' . \h($url . '&file=' . (int)$file['id']) . '">Download packing ' . (str_starts_with($file['mime'], 'video/') ? 'video' : 'photo') . ' ' . ($n + 1) . '</a></li>';
+        }
+        return $html . '</ul>' . (!$files ? '<p>No packing media is available for this order.</p>' : '') . '</main></body></html>';
+    }
+}
