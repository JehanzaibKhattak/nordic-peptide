+<?php
+declare(strict_types=1);
+namespace Avion\Messaging;
+
+use Avion\Database;
+use Avion\Http;
+
+final class RespondIoChannel implements Channel
+{
+    public const TEMPLATES = [
+        'payment_link' => ['peptbay_payment_link', ['order_number', 'total', 'link']],
+        'payment_confirmed' => ['peptbay_payment_confirmed', ['order_number']],
+        'shipped' => ['peptbay_order_shipped_v2', ['order_number', 'carrier', 'tracking_number', 'tracking_url', 'proof_url']],
+        'logistics_new_order' => ['peptbay_pack_order', ['order_number', 'items', 'pack_url']],
+    ];
+    private array $credentials;
+    private \Closure $transport;
+    private ?array $ready = null;
+
+    public function __construct(?array $credentials = null, ?callable $transport = null)
+    {
+        $this->credentials = $credentials ?? (array)\config('integrations.credentials.respondio', []);
+        $this->transport = \Closure::fromCallable($transport ?? [Http::class, 'request']);
+    }
+
+    public function request(string $method, string $path, ?array $body = null, int $timeout = 10): array
+    {
+        try {
+            return ($this->transport)($method, 'https://api.respond.io/v2' . $path,
+                $body === null ? null : json_encode($body, JSON_THROW_ON_ERROR),
+                ['Authorization' => 'Bearer ' . ($this->credentials['token'] ?? ''), 'Content-Type' => 'application/json'], $timeout);
+        } catch (\Throwable) {
+            throw new \RuntimeException('Respond.io transport failed');
+        }
+    }
+
+    public function readiness(): array
+    {
+        if ($this->ready !== null) { return $this->ready; }
+        $id = (int)($this->credentials['channel_id'] ?? 0);
+        if (empty($this->credentials['token']) || $id < 1) { throw new \RuntimeException('Respond.io is not configured'); }
+        $channels = $this->request('GET', '/space/channel');
+        if ($channels['status'] !== 200 || !in_array($id, array_column($channels['json']['items'] ?? [], 'id'), true)) {
+            throw new \RuntimeException('Respond.io channel access could not be verified');
+        }
+        $templates = $this->request('GET', '/space/channel/' . $id . '/template?limit=100');
+        if ($templates['status'] !== 200) { throw new \RuntimeException('Respond.io templates could not be read'); }
+        $approved = [];
+        foreach ($templates['json']['items'] ?? [] as $t) {
+            if (strtolower((string)($t['status'] ?? '')) === 'approved' && ($t['languageCode'] ?? '') === 'en_GB') { $approved[] = $t['name']; }
+        }
+        return $this->ready = ['channel_id' => $id, 'approved_templates' => $approved,
+            'missing_templates' => array_values(array_diff(array_column(self::TEMPLATES, 0), $approved))];
+    }
+
+    public function send(array $m): SendResult
+    {
+        $phone = (string)($m['to_address'] ?? '');
+        if (!preg_match('/^\+?[1-9]\d{7,14}$/D', $phone)) { return SendResult::fail('Invalid WhatsApp recipient'); }
+        $phone = '+' . ltrim($phone, '+');
+        $mapping = self::TEMPLATES[$m['template'] ?? ''] ?? null;
+        if (!$mapping || empty($m['id']) || empty($m['idempotency_key'])) { return SendResult::fail('Unsupported WhatsApp notification'); }
+        $params = $m['params'] ?? [];
+        $values = [];
+        foreach ($mapping[1] as $field) {
+            $value = trim((string)($params[$field] ?? ''));
+            if ($value === '' || strlen($value) > 1024) { return SendResult::fail('WhatsApp notification is missing a valid ' . $field); }
+            $values[] = ['type' => 'text', 'text' => $value];
+        }
+        try {
+            $ready = $this->readiness();
+            if (in_array($mapping[0], $ready['missing_templates'], true)) { return SendResult::fail('WhatsApp template is not approved: ' . $mapping[0]); }
+            $identifier = 'phone:' . rawurlencode($phone);
+            $contact = $this->request('GET', '/contact/' . $identifier);
+            if ($contact['status'] === 404) {
+                $created = $this->request('POST', '/contact/' . $identifier, ['firstName' => 'Peptbay customer', 'phone' => $phone]);
+                if ($created['status'] < 200 || $created['status'] >= 300) { return SendResult::fail('Respond.io contact could not be created'); }
+            } elseif ($contact['status'] !== 200) { return SendResult::retry('Respond.io contact lookup failed'); }
+        } catch (\RuntimeException) { return SendResult::retry('Respond.io preflight failed'); }
+
+        // The provider documents no idempotency key. Persist intent BEFORE sending;
+        // an ambiguous timeout/crash requires reconciliation, never a blind resend.
+        $pdo = Database::pdo();
+        $claim = $pdo->prepare("UPDATE messages SET provider_message_id = 'respond:pending' WHERE id = ? AND (provider_message_id IS NULL OR provider_message_id = '')");
+        $claim->execute([(int)$m['id']]);
+        if ($claim->rowCount() !== 1) {
+            $q = $pdo->prepare('SELECT provider_message_id FROM messages WHERE id = ?'); $q->execute([(int)$m['id']]); $existing = (string)$q->fetchColumn();
+            return preg_match('/^respond:\d+$/D', $existing) ? SendResult::sent($existing)
+                : SendResult::fail('WhatsApp delivery is uncertain; reconcile in respond.io before retrying');
+        }
+        try {
+            $r = $this->request('POST', '/contact/' . $identifier . '/message', ['channelId' => $ready['channel_id'],
+                'message' => ['type' => 'whatsapp_template', 'template' => ['name' => $mapping[0], 'languageCode' => 'en_GB',
+                    'components' => [['type' => 'body', 'parameters' => $values]]]]]);
+        } catch (\RuntimeException) { return SendResult::fail('WhatsApp delivery is uncertain; reconcile in respond.io before retrying'); }
+        $status = (int)$r['status'];
+        $id = $r['json']['messageId'] ?? null;
+        if ($status >= 200 && $status < 300 && ((is_int($id) && $id > 0) || (is_string($id) && ctype_digit($id) && (int)$id > 0))) {
+            $id = 'respond:' . $id;
+            $pdo->prepare('UPDATE messages SET provider_message_id = ? WHERE id = ?')->execute([$id, (int)$m['id']]);
+            return SendResult::sent($id);
+        }
+        if ($status >= 400 && $status < 500) {
+            $pdo->prepare('UPDATE messages SET provider_message_id = NULL WHERE id = ?')->execute([(int)$m['id']]);
+            return $status === 429 ? SendResult::retry('Respond.io rate limit') : SendResult::fail('Respond.io rejected WhatsApp notification: HTTP ' . $status);
+        }
+        return SendResult::fail('WhatsApp delivery is uncertain; reconcile in respond.io before retrying');
+    }
+
+    public function pollStatuses(): int
+    {
+        $pdo = Database::pdo();
+        $rows = $pdo->query("SELECT id, to_address, provider_message_id FROM messages WHERE channel='whatsapp' AND status='sent' AND provider_message_id REGEXP '^respond:[0-9]+$' AND sent_at > NOW() - INTERVAL 14 DAY AND next_attempt_at <= NOW() ORDER BY next_attempt_at LIMIT 25")->fetchAll();
+        $updated = 0;
+        $started = microtime(true);
+        foreach ($rows as $m) {
+            if (microtime(true) - $started >= 10) { break; }
+            $pdo->prepare('UPDATE messages SET next_attempt_at = NOW() + INTERVAL 15 MINUTE WHERE id = ?')->execute([$m['id']]);
+            try { $r = $this->request('GET', '/contact/phone:' . rawurlencode('+' . ltrim($m['to_address'], '+')) . '/message/' . substr($m['provider_message_id'], 8), null, 4); }
+            catch (\RuntimeException) { continue; }
+            if ($r['status'] !== 200 || (int)($r['json']['channelId'] ?? 0) !== (int)$this->credentials['channel_id']) { continue; }
+            foreach ($r['json']['status'] ?? [] as $status) {
+                if (in_array($status['value'] ?? '', ['delivered', 'read', 'failed'], true)) {
+                    $updated += (int)Outbox::updateStatus($m['provider_message_id'], $status['value'], $status['value'] === 'failed' ? 'WhatsApp provider reported failed delivery' : null);
+                }
+            }
+        }
+        return $updated;
+    }
+}
