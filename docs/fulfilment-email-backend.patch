+<?php
+declare(strict_types=1);
+namespace Avion { final class Uploads { public static function root(): string { return $GLOBALS['media_root']; } } }
+namespace Avion\Models { final class Order { public static function media(int $id): array { return [['path'=>'proof/'.$id.'/fixture.png','sha256'=>'fixture-hash']]; } } }
+namespace Avion\Messaging { final class Outbox { public static function queue(...$args): void {$GLOBALS['queued'][]=$args;} } }
+namespace {
+require dirname(__DIR__) . '/src/Messaging/Channel.php';
+require dirname(__DIR__) . '/src/Messaging/SendResult.php';
+require dirname(__DIR__) . '/src/Messaging/ResendChannel.php';
+require dirname(__DIR__) . '/src/Notifier.php';
+use Avion\Messaging\ResendChannel;
+function check(bool $ok): void { if (!$ok) { throw new \RuntimeException('Resend assertion failed'); } }
+$GLOBALS['media_root'] = sys_get_temp_dir() . '/avion-email-' . bin2hex(random_bytes(6));
+mkdir($GLOBALS['media_root'] . '/proof/7', 0700, true);
+$path = $GLOBALS['media_root'] . '/proof/7/fixture.png';
+file_put_contents($path, 'synthetic packing photo');
+$message = ['template'=>'shipped','order_id'=>7,'to_address'=>'recipient@example.invalid',
+    'body'=>'Synthetic tracking details','idempotency_key'=>'shipped:email:7:TEST',
+    'params'=>['order_number'=>'TEST-7','proof_media'=>[['path'=>'proof/7/fixture.png','sha256'=>hash_file('sha256',$path)]]]];
+$credentials = ['api_key'=>'fixture-secret','from'=>'Peptbay <sender@example.invalid>'];
+$calls=[];
+$channel = new ResendChannel($credentials, function($url,$body,$headers) use (&$calls) {
+    $calls[]=[$url,$body,$headers]; return ['status'=>200,'json'=>['id'=>'fixture-email']];
+});
+try {
+    Avion\Notifier::shipped(['id'=>7,'customer_id'=>1,'order_number'=>'TEST-7','carrier'=>'Royal Mail','tracking_number'=>'TESTONLY','contact_email'=>'recipient@example.invalid','contact_phone'=>'']);
+    check(count($GLOBALS['queued'])===2);
+    check(!isset($GLOBALS['queued'][0][4]['proof_media']));
+    check($GLOBALS['queued'][1][0]==='email' && $GLOBALS['queued'][1][4]['proof_media'][0]['path']==='proof/7/fixture.png');
+    $result=$channel->send($message); check($result->ok && $result->providerMessageId==='fixture-email');
+    check($calls[0][0]==='https://api.resend.com/emails');
+    check(base64_decode($calls[0][1]['attachments'][0]['content'])==='synthetic packing photo');
+    $channel->send($message); check($calls[0][2]['Idempotency-Key']===$calls[1][2]['Idempotency-Key']);
+    foreach ([400=>false,429=>true,500=>true] as $status=>$retry) {
+        $driver=new ResendChannel($credentials,fn()=>['status'=>$status,'json'=>['message'=>'fixture-secret']]);
+        $r=$driver->send($message);check(!$r->ok && $r->retryable===$retry && !str_contains($r->error,'fixture-secret'));
+    }
+    $driver=new ResendChannel($credentials,fn()=>throw new \RuntimeException('fixture-secret'));
+    check($driver->send($message)->error==='Resend transport failed');
+    $bad=$message;$bad['to_address']='invalid';check(!$channel->send($bad)->ok);
+    $bad=$message;$bad['params']['proof_media'][0]['path']='../../etc/passwd';check(!$channel->send($bad)->ok);
+    $bad=$message;$bad['order_id']=8;check(!$channel->send($bad)->ok);
+    $bad=$message;$bad['params']['proof_media'][0]['sha256']=str_repeat('0',64);check(!$channel->send($bad)->ok);
+    $stream=fopen($path,'w');ftruncate($stream,29*1024*1024);fclose($stream);
+    check(str_contains($channel->send($message)->error,'attachment limit'));
+    echo "Resend payload, media ownership/hash/size checks, retries, redaction and idempotency passed.\n";
+} finally { unlink($path);rmdir(dirname($path));rmdir(dirname(dirname($path)));rmdir($GLOBALS['media_root']); }
+}
