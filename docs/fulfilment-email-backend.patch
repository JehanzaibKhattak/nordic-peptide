+<?php
+declare(strict_types=1);
+
+namespace Avion\Messaging;
+
+use Avion\Http;
+use Avion\Uploads;
+
+/** Transactional fulfilment email; provider acceptance is not inbox delivery. */
+final class ResendChannel implements Channel
+{
+    private array $credentials;
+    private \Closure $transport;
+
+    public function __construct(?array $credentials = null, ?callable $transport = null)
+    {
+        $this->credentials = $credentials ?? (array)\config('integrations.credentials.resend', []);
+        $this->transport = \Closure::fromCallable($transport ?? [Http::class, 'postJson']);
+    }
+
+    public function send(array $message): SendResult
+    {
+        $key = (string)($this->credentials['api_key'] ?? '');
+        $from = (string)($this->credentials['from'] ?? '');
+        if ($key === '' || $from === '' || preg_match('/[\r\n]/', $from)) {
+            return SendResult::fail('Resend sender is not configured');
+        }
+        if (!filter_var($message['to_address'] ?? '', FILTER_VALIDATE_EMAIL)) {
+            return SendResult::fail('Invalid email recipient');
+        }
+        if (($message['template'] ?? '') !== 'shipped' || empty($message['idempotency_key'])) {
+            return SendResult::fail('Unsupported fulfilment email');
+        }
+        $params = $message['params'] ?? [];
+        $order = preg_replace('/[\r\n]/', '', (string)($params['order_number'] ?? ''));
+        $payload = [
+            'from' => $from, 'to' => [$message['to_address']],
+            'subject' => 'Your Peptbay order ' . $order . ' has shipped',
+            'text' => (string)($message['body'] ?? ''),
+        ];
+        try {
+            $attachments = $this->attachments($params['proof_media'] ?? [], (int)($message['order_id'] ?? 0));
+        } catch (\RuntimeException $e) {
+            return SendResult::fail($e->getMessage());
+        }
+        if ($attachments) {
+            $payload['attachments'] = $attachments;
+            $payload['text'] .= "\n\nYour packing photos/videos are attached.";
+        }
+        try {
+            $response = ($this->transport)('https://api.resend.com/emails', $payload, [
+                'Authorization' => 'Bearer ' . $key,
+                'Idempotency-Key' => 'avion-email-' . hash('sha256', (string)$message['idempotency_key']),
+            ], 30);
+        } catch (\Throwable) {
+            return SendResult::retry('Resend transport failed');
+        }
+        $status = (int)$response['status'];
+        $id = $response['json']['id'] ?? null;
+        if ($status >= 200 && $status < 300 && is_string($id) && $id !== '') {
+            return SendResult::sent($id);
+        }
+        // Do not log response bodies: providers can echo credentials, recipients or media.
+        return $status >= 500 || in_array($status, [0, 408, 429], true) || ($status >= 200 && $status < 300)
+            ? SendResult::retry('Resend HTTP ' . $status . ': email not acknowledged')
+            : SendResult::fail('Resend HTTP ' . $status . ': email rejected');
+    }
+
+    private function attachments(array $files, int $orderId): array
+    {
+        if (!$files) {
+            return [];
+        }
+        $root = realpath(Uploads::root() . '/proof/' . $orderId);
+        if ($orderId <= 0 || $root === false) {
+            throw new \RuntimeException('Packing media is unavailable');
+        }
+        $result = [];
+        $encodedBytes = 0;
+        foreach ($files as $file) {
+            $path = realpath(Uploads::root() . '/' . (string)($file['path'] ?? ''));
+            if (!$path || !str_starts_with($path, $root . '/') || !is_file($path) || !is_readable($path)) {
+                throw new \RuntimeException('Packing media is unavailable');
+            }
+            $size = filesize($path);
+            $encodedBytes += 4 * (int)ceil($size / 3);
+            // Resend allows 40 MB including Base64; leave room for MIME/body overhead.
+            if ($encodedBytes > 36 * 1024 * 1024) {
+                throw new \RuntimeException('Packing media exceeds email attachment limit; smaller files required');
+            }
+            if (!hash_equals((string)($file['sha256'] ?? ''), (string)hash_file('sha256', $path))) {
+                throw new \RuntimeException('Packing media changed since approval');
+            }
+            $content = file_get_contents($path);
+            if ($content === false) {
+                throw new \RuntimeException('Packing media is unavailable');
+            }
+            $result[] = ['filename' => basename($path), 'content' => base64_encode($content)];
+        }
+        return $result;
+    }
+}
