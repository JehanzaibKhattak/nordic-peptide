+<?php
+declare(strict_types=1);
+
+// CLI only. Reads a private JSON credential file; never prints tokens or credentials.
+require dirname(__DIR__) . '/src/bootstrap.php';
+if (PHP_SAPI !== 'cli') { http_response_code(404); exit; }
+try {
+    $path = $argv[1] ?? '';
+    if ($path === '' || !is_file($path)) throw new RuntimeException('Provide the private Parcel2Go JSON credential file path');
+    $credentials = json_decode(file_get_contents($path), true, 16, JSON_THROW_ON_ERROR);
+    $client = new Avion\Shipping\Parcel2Go($credentials);
+    $result = $client->authenticate();
+    if (in_array('--quote', $argv, true)) {
+        // Documentation sample, not the store's actual package or a shipment booking.
+        $quotes = $client->quotes(1, 20, 15, 10, 100);
+        $result['sample_quote_count'] = count($quotes);
+    }
+    echo json_encode($result, JSON_THROW_ON_ERROR), PHP_EOL;
+} catch (Throwable $e) { fwrite(STDERR, $e instanceof JsonException ? "Invalid private credential file\n" : $e->getMessage() . "\n"); exit(1); }
