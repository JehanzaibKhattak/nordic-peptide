+<?php
+declare(strict_types=1);
+
+namespace Avion\Shipping;
+
+use Avion\Http;
+
+/** Server-to-server authentication and quotes. No booking or payment endpoints. */
+final class Parcel2Go
+{
+    private \Closure $request;
+    private string $base;
+    private ?string $token = null;
+    private int $expires = 0;
+
+    public function __construct(private array $credentials, ?callable $request = null)
+    {
+        $mode = $credentials['mode'] ?? '';
+        if (!in_array($mode, ['live', 'sandbox'], true) || empty($credentials['client_id']) || empty($credentials['client_secret'])) {
+            throw new \RuntimeException('Parcel2Go mode, client ID and secret are required');
+        }
+        $this->base = $mode === 'live' ? 'https://www.parcel2go.com' : 'https://sandbox.parcel2go.com';
+        $this->request = $request !== null ? \Closure::fromCallable($request) : Http::request(...);
+    }
+
+    /** Authentication metadata only; the bearer token never leaves this client. */
+    public function authenticate(): array
+    {
+        if ($this->token !== null && time() < $this->expires) return ['connected' => true, 'mode' => $this->credentials['mode']];
+        $response = $this->call('POST', '/auth/connect/token', http_build_query([
+            'grant_type' => 'client_credentials', 'scope' => 'public-api',
+            'client_id' => $this->credentials['client_id'], 'client_secret' => $this->credentials['client_secret'],
+        ]), ['Content-Type' => 'application/x-www-form-urlencoded']);
+        $data = $response['json'] ?? null;
+        if (($response['status'] ?? 0) !== 200 || !is_array($data) || !is_string($data['access_token'] ?? null)
+            || $data['access_token'] === '' || strcasecmp((string)($data['token_type'] ?? ''), 'Bearer') !== 0
+            || !is_numeric($data['expires_in'] ?? null) || (int)$data['expires_in'] < 1) {
+            throw new \RuntimeException('Parcel2Go authentication failed (HTTP ' . (int)($response['status'] ?? 0) . ')');
+        }
+        $this->token = $data['access_token'];
+        $this->expires = time() + max(0, (int)$data['expires_in'] - 30);
+        return ['connected' => true, 'mode' => $this->credentials['mode']];
+    }
+
+    /** Anonymous UK-to-UK quote; kilograms, centimetres and declared GBP value. */
+    public function quotes(float $weight, float $length, float $width, float $height, float $value): array
+    {
+        foreach ([$weight, $length, $width, $height] as $n) if (!is_finite($n) || $n <= 0 || $n > 1000) throw new \InvalidArgumentException('Invalid Parcel2Go parcel measurements');
+        if (!is_finite($value) || $value < 0 || $value > 1000000) throw new \InvalidArgumentException('Invalid Parcel2Go parcel value');
+        $this->authenticate();
+        $body = json_encode(['CollectionAddress' => ['Country' => 'GBR'], 'DeliveryAddress' => ['Country' => 'GBR'],
+            'Parcels' => [['Value' => $value, 'Weight' => $weight, 'Length' => $length, 'Width' => $width, 'Height' => $height]]], JSON_THROW_ON_ERROR);
+        $response = $this->call('POST', '/api/quotes', $body, ['Content-Type' => 'application/json', 'Authorization' => 'Bearer ' . $this->token]);
+        if (($response['status'] ?? 0) === 401) { $this->token = null; $this->expires = 0; }
+        if (($response['status'] ?? 0) !== 200 || !is_array($response['json']['Quotes'] ?? null)) {
+            throw new \RuntimeException('Parcel2Go quotes failed (HTTP ' . (int)($response['status'] ?? 0) . ')');
+        }
+        return $response['json']['Quotes'];
+    }
+
+    private function call(string $method, string $path, string $body, array $headers): array
+    {
+        try { return ($this->request)($method, $this->base . $path, $body, $headers + ['Accept' => 'application/json', 'User-Agent' => 'Peptbay-Avion/1.0'], 25); }
+        catch (\Throwable) { throw new \RuntimeException('Parcel2Go transport failed'); }
+    }
+}
