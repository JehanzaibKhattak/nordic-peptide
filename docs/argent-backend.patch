+    }
+    throws(fn()=>Avion\ArgentPayments::validate($intent,['id'=>'payment_fixture','payment_intent'=>'other','status'=>'paid'],Order::find($id),'fixture-company'),RuntimeException::class);
+    putenv('ARGENT_MODE=test');
+    throws(fn()=>Avion\ArgentPayments::reconcile(Order::find($id),'intent_fixture','paid',static fn()=>throw new Fail('Test mode contacted provider')),RuntimeException::class);
+    eq(null,Order::find($id)['paid_at']);eq(0,count(Avion\Tracking\Keitaro::jobs($id)));
+});
+test('argent: verifies refund before local success without queuing fulfilment', function () {
+    [$id,$intent,$payment]=argentFixture(); $payment['status']='refunded';
+    Setting::set('logistics_whatsapp','447700900123');
+    $messages=(int)one('SELECT COUNT(*) FROM messages');
+    $fetch=static fn(string $path): array => str_starts_with($path,'/payments/') ? $payment : $intent;
+    Avion\ArgentPayments::reconcile(Order::find($id),'intent_fixture','refunded',$fetch);
+    Avion\ArgentPayments::reconcile(Order::find($id),'intent_fixture','refunded',$fetch);
+    eq($messages,(int)one('SELECT COUNT(*) FROM messages'));
+    eq('cancelled',Order::find($id)['bucket']);ok((bool)Order::find($id)['affiliate_reversed_at']);eq(2,count(Avion\Tracking\Keitaro::jobs($id)));
+    eq(1,(int)one("SELECT COUNT(*) FROM timeline_events WHERE type='argent_refund'"));
+    throws(fn()=>Avion\ArgentPayments::reconcile(Order::find($id),'intent_fixture','paid',$fetch),RuntimeException::class);
+});
+test('argent: an already shipped refund goes to attention and cannot be replayed as paid', function () {
+    [$id,$intent,$payment]=argentFixture();
+    $fetch=static fn(string $path): array => str_starts_with($path,'/payments/') ? $payment : $intent;
+    Avion\ArgentPayments::reconcile(Order::find($id),'intent_fixture','paid',$fetch);
+    db()->prepare("UPDATE orders SET bucket='done' WHERE id=?")->execute([$id]);
+    $payment['status']='refunded';
+    $refundFetch=static fn(string $path): array => str_starts_with($path,'/payments/') ? $payment : $intent;
+    Avion\ArgentPayments::reconcile(Order::find($id),'intent_fixture','refunded',$refundFetch);
+    eq('attention',Order::find($id)['bucket']);
+    throws(fn()=>Avion\ArgentPayments::reconcile(Order::find($id),'intent_fixture','paid',$fetch),RuntimeException::class);
+});
