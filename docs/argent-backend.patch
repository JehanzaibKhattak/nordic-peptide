+<?php
+declare(strict_types=1);
+namespace Avion;
+
+use Avion\Models\Order;
+use Avion\Models\TimelineEvent;
+use Avion\Tracking\Keitaro;
+
+/** Independent provider verification at the fulfilment boundary. Test payments are never accepted here. */
+final class ArgentPayments
+{
+    public static function validate(array $intent, array $payment, array $order, string $company): void
+    {
+        $totals = json_decode($order['retail_totals'] ?? 'null', true);
+        $paymentId = is_array($intent['payment'] ?? null) ? ($intent['payment']['id'] ?? null) : ($intent['payment'] ?? null);
+        $boundIntent = is_array($payment['payment_intent'] ?? null) ? ($payment['payment_intent']['id'] ?? null) : ($payment['payment_intent'] ?? null);
+        if (!is_array($totals) || ($totals['currency'] ?? '') !== 'GBP' || ($intent['live'] ?? null) !== true
+            || ($intent['status'] ?? '') !== 'completed' || ($intent['company']['id'] ?? '') !== $company
+            || ($intent['reference'] ?? '') !== ($order['source_order_ref'] ?? '')
+            || ($intent['currency']['code'] ?? '') !== 'GBP' || !is_numeric($intent['amount'] ?? null)
+            || abs((float)$intent['amount'] * 100 - round((float)$intent['amount'] * 100)) > 0.00001
+            || (int)round((float)$intent['amount'] * 100) !== (int)round((float)$totals['total'] * 100)
+            || !is_string($paymentId) || ($payment['id'] ?? '') !== $paymentId
+            || $boundIntent !== ($intent['id'] ?? '')
+            || !in_array($payment['status'] ?? '', ['paid','refunded'], true)) {
+            throw new \RuntimeException('argent_payment_mismatch');
+        }
+    }
+
+    public static function reconcile(array $order, string $intentId, string $event, ?callable $retrieve = null): void
+    {
+        $secret = (string)getenv('ARGENT_SECRET_KEY'); $company = (string)getenv('ARGENT_COMPANY_ID');
+        if (getenv('ARGENT_MODE') !== 'live' || getenv('ARGENT_ALLOW_LIVE') !== 'true' || !$secret || !$company) throw new \RuntimeException('argent_not_configured');
+        $retrieve ??= static function (string $path) use ($secret): array {
+            $result = Http::request('GET', 'https://api.argentplatforms.com'.$path, null, ['Authorization'=>'Basic '.base64_encode($secret.':')]);
+            if ($result['status'] !== 200 || !is_array($result['json'])) throw new \RuntimeException('argent_unavailable');
+            return $result['json'];
+        };
+        if (!preg_match('/^[A-Za-z0-9_-]{1,80}$/D', $intentId) || !in_array($event,['paid','refunded'],true)) throw new \RuntimeException('argent_invalid_request');
+        $intent = $retrieve('/payment-intents/'.$intentId);
+        if (($intent['id'] ?? '') !== $intentId) throw new \RuntimeException('argent_payment_mismatch');
+        $paymentId = is_array($intent['payment'] ?? null) ? ($intent['payment']['id'] ?? '') : ($intent['payment'] ?? '');
+        if (!is_string($paymentId) || !preg_match('/^[A-Za-z0-9_-]{1,80}$/D',$paymentId)) throw new \RuntimeException('argent_capture_missing');
+        $payment = $retrieve('/payments/'.$paymentId);
+        self::validate($intent,$payment,$order,$company);
+        if (($event === 'refunded') !== (($payment['status'] ?? '') === 'refunded')) throw new \RuntimeException('argent_event_mismatch');
+        Database::tx(static function () use ($order,$intent,$payment,$event,$company,$paymentId): void {
+            $s=Database::pdo()->prepare('SELECT * FROM orders WHERE id=? FOR UPDATE'); $s->execute([(int)$order['id']]); $locked=$s->fetch();
+            if (!$locked) throw new \RuntimeException('order_not_found');
+            self::validate($intent,$payment,$locked,$company);
+            if ($locked['payment_method'] === 'bank_transfer') throw new \RuntimeException('argent_method_mismatch');
+            $reference='argent:'.$paymentId;
+            if ($locked['paid_at'] && ($locked['payment_ref'] ?? '') !== $reference) throw new \RuntimeException('argent_existing_payment_mismatch');
+            if ($event === 'paid' && $locked['affiliate_reversed_at']) throw new \RuntimeException('argent_already_reversed');
+            if (!$locked['paid_at']) {
+                $totals=json_decode($locked['retail_totals'],true);
+                $result=Order::markPaid((int)$locked['id'],['amount'=>$totals['total'],'ccy'=>'GBP','ref'=>$reference,'method'=>'online','skip_notifications'=>$event==='refunded']);
+                if (!$result['ok']) throw new \RuntimeException('argent_payment_sync_failed');
+            }
+            if ($event === 'refunded' && !$locked['affiliate_reversed_at']) {
+                Keitaro::reverse((int)$locked['id'],null);
+                Database::pdo()->prepare("UPDATE orders SET bucket=IF(bucket='done','attention','cancelled'),cancelled_at=NOW(),cancel_reason='Argent confirmed full refund' WHERE id=?")->execute([(int)$locked['id']]);
+                TimelineEvent::add((int)$locked['customer_id'],'argent_refund',title:'Argent full refund verified',body:$reference,orderId:(int)$locked['id']);
+                Audit::record('order',(int)$locked['id'],'argent_refunded',null,['payment_ref'=>$reference]);
+            }
+        });
+    }
+}
